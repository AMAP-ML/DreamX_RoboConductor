{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Showcase core containers; see DATA_CONTRACTS.md for runtime fields",
  "type": "object", "required": ["updatedAt", "simulation", "real", "walkthrough"],
  "properties": {
    "synthetic": {"type": "boolean"}, "updatedAt": {"type": "string"},
    "simulation": {"type": "object", "required": ["taskCount", "trials", "successes", "perfectTasks", "turns", "tasks", "featured"], "properties": {"tasks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "trials", "successes", "outcomes"], "properties": {"outcomes": {"type": "array", "minItems": 1}}}}, "featured": {"type": "array"}}},
    "real": {"type": "object", "required": ["taskCount", "plannedTaskCount", "trials", "confirmedTrials", "successes", "tasks"], "properties": {"tasks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "instructionEn", "episodes"], "properties": {"episodes": {"type": "array", "minItems": 1}}}}}},
    "walkthrough": {"type": "object", "required": ["id", "task", "seed", "manual", "steps"], "properties": {"manual": {"type": "object", "required": ["task", "tips"]}, "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["turn", "event", "frames", "commands", "results"]}}}}
  }
}
